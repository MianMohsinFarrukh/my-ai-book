<!-- Placeholder for VLA systems blog image -->
<svg width="800" height="400" xmlns="http://www.w3.org/2000/svg">
  <rect width="800" height="400" fill="#4f8bf9"/>
  <text x="400" y="60" font-family="Arial" font-size="24" fill="white" text-anchor="middle">Vision-Language-Action Systems</text>
  <text x="400" y="100" font-family="Arial" font-size="18" fill="white" text-anchor="middle">The Next Frontier in Embodied AI</text>
  <circle cx="200" cy="200" r="50" fill="white" opacity="0.9"/>
  <text x="200" y="205" font-family="Arial" font-size="14" fill="#4f8bf9" text-anchor="middle">Vision</text>
  <circle cx="400" cy="150" r="50" fill="#735ce6" opacity="0.9"/>
  <text x="400" y="155" font-family="Arial" font-size="14" fill="white" text-anchor="middle">Language</text>
  <circle cx="600" cy="200" r="50" fill="white" opacity="0.9"/>
  <text x="600" y="205" font-family="Arial" font-size="14" fill="#4f8bf9" text-anchor="middle">Action</text>
  <path d="M250,200 L350,170" stroke="white" stroke-width="3" marker-end="url(#arrow)"/>
  <path d="M450,170 L550,200" stroke="white" stroke-width="3" marker-end="url(#arrow)"/>
  <path d="M550,200 L450,230" stroke="white" stroke-width="3" marker-end="url(#arrow)"/>
  <path d="M350,230 L250,200" stroke="white" stroke-width="3" marker-end="url(#arrow)"/>
  <defs>
    <marker id="arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto" markerUnits="strokeWidth">
      <path d="M0,0 L0,6 L9,3 z" fill="white" />
    </marker>
  </defs>
</svg>